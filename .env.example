# === CareBank Backend Configuration ===
# Copy this file to .env and fill in values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=carebank
DB_PASSWORD=your_db_password_here
DB_NAME=carebank_db

# Redis
REDIS_URL=redis://localhost:6379

# Agentic proxy connection
BANKING_API_URL=http://localhost:8001
BANKING_API_SECRET=generate_a_strong_secret_here
PROXY_WEBHOOK_SECRET=generate_a_strong_secret_here

# LLM Providers (configure at least one)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional: Override JWT (auto-derived from BANKING_API_SECRET if empty)
JWT_SECRET=

# Environment: development | production
ENVIRONMENT=development
